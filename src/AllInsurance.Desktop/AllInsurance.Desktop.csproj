<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.7.25</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\allinsurance.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\logo-99.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\allinsurance.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Icons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Sections\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Reference\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Icons\LICENSE-lucide.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AllInsurance.Application\AllInsurance.Application.csproj" />
    <ProjectReference Include="..\AllInsurance.Infrastructure\AllInsurance.Infrastructure.csproj" />
  </ItemGroup>
</Project>
