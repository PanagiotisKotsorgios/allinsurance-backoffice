<Page
    x:Class="AllInsurance.Desktop.Views.AdministratorSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="650">
            <Border Width="440" Padding="32" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="ALL INSURANCE" Foreground="{ThemeResource BrandAccentBrush}"
                               FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="Set up All Insurance" FontSize="30" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Create the first local administrator account." Foreground="{ThemeResource SecondaryTextBrush}"
                               FontSize="15" TextWrapping="Wrap" />

                    <TextBlock Text="Username" />
                    <TextBox x:Name="UsernameInput" Text="{Binding Username, Mode=TwoWay}"
                             AutomationProperties.Name="Username" />
                    <TextBlock Text="Full name" />
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                             AutomationProperties.Name="Full name" />
                    <TextBlock Text="Password" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged"
                                 AutomationProperties.Name="Password" />
                    <TextBlock Text="Confirm password" />
                    <PasswordBox x:Name="ConfirmationInput" PasswordChanged="ConfirmationChanged"
                                 AutomationProperties.Name="Confirm password" />
                    <CheckBox Content="Show passwords" Checked="ShowPasswordsChanged"
                              Unchecked="ShowPasswordsChanged" />
                    <TextBlock Text="Use a passphrase with at least 12 characters."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorTextBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                                  HorizontalAlignment="Center" />
                    <Button Content="Create administrator" Command="{Binding CreateAdministratorCommand}"
                            Background="{ThemeResource ButtonAccentBrush}" Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
