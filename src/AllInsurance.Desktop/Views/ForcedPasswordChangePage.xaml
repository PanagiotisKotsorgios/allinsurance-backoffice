<Page
    x:Class="AllInsurance.Desktop.Views.ForcedPasswordChangePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="650">
            <Border Width="460" Padding="32" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="ALL INSURANCE" Foreground="{ThemeResource BrandAccentBrush}"
                               FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="Choose a new password" FontSize="30" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Your administrator provided a temporary password. Replace it before continuing."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="New password" />
                    <PasswordBox x:Name="NewPasswordInput" PasswordChanged="NewPasswordChanged"
                                 AutomationProperties.Name="New password" />
                    <TextBlock Text="Confirm password" />
                    <PasswordBox x:Name="ConfirmationInput" PasswordChanged="ConfirmationChanged"
                                 AutomationProperties.Name="Confirm password" />
                    <TextBlock Text="Use a passphrase with at least 12 characters."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorTextBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                                  HorizontalAlignment="Center" />
                    <Button Content="Change password" Command="{Binding ChangePasswordCommand}"
                            Background="{ThemeResource ButtonAccentBrush}" Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
