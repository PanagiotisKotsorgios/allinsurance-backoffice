<Page
    x:Class="AllInsurance.Desktop.Views.StartupFailurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid MinHeight="650">
        <Border Width="500" Padding="32" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="ALL INSURANCE" Foreground="{ThemeResource BrandAccentBrush}"
                           FontSize="13" FontWeight="Bold" />
                <TextBlock Text="The local database could not be initialized" FontSize="28"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Check that your Windows account can access its Local AppData folder and that the disk has free space. Close and reopen the application to retry. If the problem continues, preserve the local database and contact your system administrator."
                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
