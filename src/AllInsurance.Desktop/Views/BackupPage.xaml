<Page
    x:Class="AllInsurance.Desktop.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer SizeChanged="Scroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="1100" Margin="24" Spacing="16" HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Αντίγραφα ασφαλείας" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Δημιουργήστε πλήρες τοπικό αντίγραφο της βάσης δεδομένων, ακόμη και όσο η εφαρμογή λειτουργεί. Η επαναφορά αντικαθιστά την τρέχουσα βάση αφού αποθηκεύσει αυτόματα ένα αντίγραφό της."
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="FolderText" TextWrapping="Wrap" />
                    <controls:ActionButton Kind="Save" Label="Δημιουργία αντιγράφου ασφαλείας"
                                           HorizontalAlignment="Left" Click="Create_Click" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Διαθέσιμα αντίγραφα" FontSize="18" FontWeight="SemiBold" />
                    <ListView x:Name="BackupsList" Height="400" SelectionMode="None" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
