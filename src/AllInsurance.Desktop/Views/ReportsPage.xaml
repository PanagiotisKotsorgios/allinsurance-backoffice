<Page x:Class="AllInsurance.Desktop.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <StackPanel Spacing="3">
            <TextBlock Text="Αναφορές και πίνακες παραγωγής" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Παραγωγή, οικονομικά, πελάτες, συνεργάτες, ζημιές και οχήματα"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="14">
            <StackPanel Spacing="10">
                <TextBox x:Name="SearchInput" Header="Αναζήτηση στην αναφορά" PlaceholderText="Αριθμός, πρόσωπο, εταιρεία ή κατάσταση"
                         TextChanged="FiltersChanged" />
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="205" ItemHeight="76">
                    <ComboBox x:Name="ReportType" Header="Είδος αναφοράς" Width="195" SelectionChanged="FiltersChanged">
                        <ComboBoxItem Content="Σύνοψη" /><ComboBoxItem Content="Παραγωγή ασφαλιστηρίων" />
                        <ComboBoxItem Content="Ασφαλιστικές / αποδόσεις" /><ComboBoxItem Content="Συνεργάτες / προμήθειες" />
                        <ComboBoxItem Content="Πελάτες / υπόλοιπα" /><ComboBoxItem Content="Ζημιές" />
                        <ComboBoxItem Content="Οχήματα" /><ComboBoxItem Content="Κινήσεις πελατών" />
                        <ComboBoxItem Content="Εισπράξεις" />
                        <ComboBoxItem Content="Πίνακας παραγωγής · συνεργάτης και εταιρεία" />
                        <ComboBoxItem Content="Πίνακας παραγωγής · ανά συνεργάτη" />
                        <ComboBoxItem Content="Πίνακας παραγωγής · ανά εταιρεία" />
                    </ComboBox>
                    <ComboBox x:Name="DateBasis" Header="Ημερομηνία παραγωγής" Width="195"
                              SelectedIndex="0" SelectionChanged="FiltersChanged">
                        <ComboBoxItem Content="Έκδοση" /><ComboBoxItem Content="Έναρξη" />
                    </ComboBox>
                    <ComboBox x:Name="MonthFilter" Header="Μήνας" Width="195"
                              SelectionChanged="Month_Changed" />
                    <ComboBox x:Name="CompanyFilter" Header="Εταιρεία" Width="195" SelectionChanged="FiltersChanged" />
                    <ComboBox x:Name="BranchFilter" Header="Κλάδος" Width="195" SelectionChanged="FiltersChanged" />
                    <ComboBox x:Name="PartnerFilter" Header="Συνεργάτης" Width="195" SelectionChanged="FiltersChanged" />
                    <ComboBox x:Name="ReceiptCustomerFilter" Header="Πελάτης" Width="195"
                              Visibility="Collapsed" SelectionChanged="FiltersChanged" />
                    <ComboBox x:Name="ReceiptMethodFilter" Header="Τρόπος πληρωμής" Width="195"
                              Visibility="Collapsed" SelectionChanged="FiltersChanged" />
                    <StackPanel><TextBlock Text="Από" /><controls:EditableDateInput x:Name="FromDate" Width="195" Height="42" DateChanged="FiltersChanged" /></StackPanel>
                    <StackPanel><TextBlock Text="Έως" /><controls:EditableDateInput x:Name="UntilDate" Width="195" Height="42" DateChanged="FiltersChanged" /></StackPanel>
                </VariableSizedWrapGrid>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" FontSize="16" />
                <TextBlock x:Name="DetailText" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <controls:ActionButton Grid.Column="1" Kind="File" Label="Εξαγωγή CSV" Click="Export_Click" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="12">
            <Grid x:Name="ReportTableGrid" RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="2*,1.3*,1.3*,1.2*,1.2*,1.2*" Background="{ThemeResource TableHeaderBackgroundBrush}">
                    <TextBlock x:Name="HeadA" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadB" Grid.Column="1" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadC" Grid.Column="2" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadD" Grid.Column="3" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadE" Grid.Column="4" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadF" Grid.Column="5" Margin="10,9" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="ReportList" Grid.Row="1" SelectionMode="None" />
            </Grid>
        </Border>
    </Grid>
</Page>
