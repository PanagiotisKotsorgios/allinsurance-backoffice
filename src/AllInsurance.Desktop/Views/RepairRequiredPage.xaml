<Page
    x:Class="AllInsurance.Desktop.Views.RepairRequiredPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid MinHeight="650">
        <Border Width="500" Padding="32" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="ALL INSURANCE" Foreground="{ThemeResource BrandAccentBrush}"
                           FontSize="13" FontWeight="Bold" />
                <TextBlock Text="Administrator recovery required" FontSize="28"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="This existing database has no active administrator. The application will not create another administrator automatically."
                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Restore a protected backup or contact your authorized system administrator for identity-verified recovery. Do not delete the database or use an undocumented master password."
                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
