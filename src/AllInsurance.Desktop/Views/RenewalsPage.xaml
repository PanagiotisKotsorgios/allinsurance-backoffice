<Page x:Class="AllInsurance.Desktop.Views.RenewalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,8" RowDefinitions="Auto,*" RowSpacing="8">
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,10">
            <StackPanel Spacing="9">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Ανανεώσεις ασφαλιστηρίων" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Height="46" CornerRadius="9" BorderBrush="{ThemeResource TableBorderBrush}"
                        BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" Height="42" BorderThickness="0"
                                 Padding="42,7,12,7" VerticalContentAlignment="Center"
                                 PlaceholderText="Αριθμός ασφαλιστηρίου, πελάτης ή εταιρεία"
                                 TextChanged="Search_Changed" />
                        <controls:SearchGlyph Width="24" Height="24" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ActionButton x:Name="Days30Button" Kind="Choice" Label="30 ημέρες"
                                               Click="Days30_Click" />
                        <controls:ActionButton x:Name="Days60Button" Kind="Choice" Label="60 ημέρες"
                                               Click="Days60_Click" />
                        <ComboBox x:Name="CompanyFilter" Width="220" PlaceholderText="Όλες οι εταιρείες"
                                  SelectionChanged="Company_Changed" />
                        <TextBlock Text="Λήξη από" VerticalAlignment="Center" />
                        <controls:EditableDateInput x:Name="FromDate" Width="145" Height="42"
                                                    DateChanged="Date_Changed" />
                        <TextBlock Text="έως" VerticalAlignment="Center" />
                        <controls:EditableDateInput x:Name="UntilDate" Width="145" Height="42"
                                                    DateChanged="Date_Changed" />
                        <controls:ActionButton Kind="Clear" Label="Καθαρισμός φίλτρων"
                                               Click="Clear_Click" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,10">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <Border Background="{ThemeResource TableHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid ColumnDefinitions="2*,1.2*,1.7*,2*,2*,2*" Height="40">
                        <TextBlock Text="Αριθμός συμβολαίου" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Λήξη" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Ημέρες για τη λήξη" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Ασφαλιστική" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Συνεργάτης" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Πελάτης" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <ListView x:Name="RenewalsList" Grid.Row="1" SelectionMode="Single"
                          DoubleTapped="Open_DoubleTapped" BorderBrush="{ThemeResource TableBorderBrush}"
                          BorderThickness="1,0,1,1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="42" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,1.2*,1.7*,2*,2*,2*" Height="40">
                                <TextBlock Text="{Binding Number}" Grid.Column="0" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Expiry}" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DaysLeft}" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Insurer}" Grid.Column="3" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Partner}" Grid.Column="4" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Customer}" Grid.Column="5" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                    <controls:ActionButton Grid.Column="1" Kind="Open" Label="Άνοιγμα ασφαλιστηρίου"
                                           Click="Open_Click" />
                    <controls:ActionButton Grid.Column="2" Kind="Add" Label="Νέο ανανεωτήριο"
                                           Click="Create_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
