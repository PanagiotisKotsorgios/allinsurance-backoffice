<Page x:Class="AllInsurance.Desktop.Views.CommunicationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,12" RowDefinitions="Auto,Auto,2*,Auto,1.3*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Ενημέρωση" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Επιλογή παραληπτών από ασφαλιστήρια που λήγουν και σύνταξη μηνυμάτων"
                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="CreditsText" Text="SMS credits: —" VerticalAlignment="Center" FontWeight="SemiBold" />
                <controls:ActionButton Kind="Add" Label="Προσθήκη credits" Click="Credits_Click" />
                <controls:ActionButton Kind="Edit" Label="Ρυθμίσεις αποστολής" Click="Settings_Click" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="14">
            <StackPanel Spacing="9">
                <TextBox x:Name="SearchInput" Header="Αναζήτηση" PlaceholderText="Πελάτης, αριθμός, εταιρεία ή κλάδος"
                         TextChanged="FiltersChanged" />
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="205" ItemHeight="76">
                    <ComboBox x:Name="ChannelChoice" Header="Κανάλι" Width="195" SelectionChanged="ChannelChanged">
                        <ComboBoxItem Content="SMS" /><ComboBoxItem Content="Email" />
                    </ComboBox>
                    <ComboBox x:Name="DocumentFilter" Header="Είδος εγγράφου" Width="195" SelectionChanged="FiltersChanged">
                        <ComboBoxItem Content="Όλα" /><ComboBoxItem Content="Ασφαλιστήρια" />
                        <ComboBoxItem Content="Αιτήσεις" /><ComboBoxItem Content="Ειδοποιητήρια" />
                    </ComboBox>
                    <ComboBox x:Name="CompanyFilter" Header="Εταιρεία" Width="195" SelectionChanged="FiltersChanged" />
                    <StackPanel><TextBlock Text="Λήξη από" /><controls:EditableDateInput x:Name="FromDate" Width="195" Height="42" DateChanged="FiltersChanged" /></StackPanel>
                    <StackPanel><TextBlock Text="Λήξη έως" /><controls:EditableDateInput x:Name="UntilDate" Width="195" Height="42" DateChanged="FiltersChanged" /></StackPanel>
                </VariableSizedWrapGrid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <CheckBox x:Name="SelectAll" Content="Επιλογή όλων" Checked="SelectAll_Changed"
                              Unchecked="SelectAll_Changed" VerticalAlignment="Center" />
                    <TextBlock x:Name="RecipientsText" Grid.Column="1" VerticalAlignment="Center" />
                    <controls:ActionButton Grid.Column="2" Kind="Open" Label="Καρτέλα ασφαλιστηρίου"
                                           Click="OpenPolicy_Click" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="42,2*,150,165,120,130,110" Background="{ThemeResource TableHeaderBackgroundBrush}">
                    <TextBlock Grid.Column="1" Text="Πελάτης" Margin="8,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Παραλήπτης" Margin="8,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Ασφαλιστήριο" Margin="8,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Εταιρεία" Margin="8,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Λήξη" Margin="8,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Είδος" Margin="8,9" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="RecipientsList" Grid.Row="2" SelectionMode="Single" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="Σύνταξη μηνύματος" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="14">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <StackPanel x:Name="EmailHeader" Spacing="8" Visibility="Collapsed">
                    <TextBox x:Name="SubjectInput" Header="Θέμα email" PlaceholderText="π.χ. Υπενθύμιση ανανέωσης ασφαλιστηρίου" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Έντονα" Click="Bold_Click" />
                        <Button Content="Πλάγια" Click="Italic_Click" />
                        <Button Content="Υπογράμμιση" Click="Underline_Click" />
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="SmsBody" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="Γράψτε το σύντομο SMS..." TextChanged="SmsBody_Changed" />
                <RichEditBox x:Name="EmailBody" Grid.Row="1" Visibility="Collapsed" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="ComposeStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <controls:ActionButton Kind="File" Label="Αποθήκευση πρόχειρου" Click="SaveDraft_Click" />
                        <controls:ActionButton Kind="Open" Label="Προεπισκόπηση" Click="Preview_Click" />
                        <controls:ActionButton x:Name="SendButton" Kind="Add" Label="Αποστολή" Click="Send_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
