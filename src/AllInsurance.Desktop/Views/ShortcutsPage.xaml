<Page
    x:Class="AllInsurance.Desktop.Views.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer SizeChanged="Scroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="1100" Margin="24" Spacing="18" HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Διαχείριση συντομεύσεων" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Οι συνδυασμοί πλήκτρων λειτουργούν σε όλη τη συνδεδεμένη διεπαφή."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                <StackPanel Spacing="14">
                    <CheckBox x:Name="EnabledChoice" Content="Ενεργοποίηση συντομεύσεων πληκτρολογίου" />
                    <controls:ActionButton Kind="Save" Label="Αποθήκευση" Click="Save_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <ListView x:Name="ShortcutsList" SelectionMode="None" AutomationProperties.Name="Συντομεύσεις πληκτρολογίου">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="180,*" ColumnSpacing="16" Padding="4">
                                    <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
