<Page
    x:Class="AllInsurance.Desktop.Views.RecoveryCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid MinHeight="650">
        <Border Width="500" Padding="32" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="18">
                <TextBlock Text="ALL INSURANCE" Foreground="{ThemeResource BrandAccentBrush}"
                           FontSize="13" FontWeight="Bold" />
                <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="This code is shown only once. Store it somewhere secure and separate from your password."
                           Foreground="{ThemeResource SecondaryTextBrush}" FontSize="15" TextWrapping="Wrap" />
                <TextBox Text="{Binding Code}" IsReadOnly="True" FontFamily="Consolas" FontSize="18"
                         TextAlignment="Center" AutomationProperties.Name="One-time recovery code" />
                <Button Content="Copy code" Command="{Binding CopyCodeCommand}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                <CheckBox Content="I have stored this recovery code"
                          IsChecked="{Binding Acknowledged, Mode=TwoWay}" />
                <Button Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}"
                        Background="{ThemeResource ButtonAccentBrush}" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
