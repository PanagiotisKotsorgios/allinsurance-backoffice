<Page
    x:Class="AllInsurance.Desktop.Views.RecoveryCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Border MaxWidth="500" Margin="12" Padding="20" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image Source="ms-appx:///Assets/logo-99.jpg" Width="44" Height="44" AutomationProperties.Name="Λογότυπο AllInsurance Backoffice Software" />
                    <TextBlock Text="AllInsurance Backoffice Software" Foreground="{ThemeResource BrandAccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="Αυτός ο κωδικός εμφανίζεται μόνο μία φορά. Φυλάξτε τον σε ασφαλές μέρος, χωριστά από τον κωδικό πρόσβασης."
                           Foreground="{ThemeResource SecondaryTextBrush}" FontSize="15" TextWrapping="Wrap" />
                <TextBox Text="{Binding Code}" IsReadOnly="True" FontFamily="Consolas" FontSize="18"
                         TextAlignment="Center" AutomationProperties.Name="Κωδικός ανάκτησης μίας χρήσης" />
                <Button Content="Αντιγραφή κωδικού" Command="{Binding CopyCodeCommand}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                <CheckBox Content="Έχω αποθηκεύσει τον κωδικό ανάκτησης"
                          IsChecked="{Binding Acknowledged, Mode=TwoWay}" />
                <Button Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}"
                        Background="{ThemeResource ButtonAccentBrush}" Foreground="White" />
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
