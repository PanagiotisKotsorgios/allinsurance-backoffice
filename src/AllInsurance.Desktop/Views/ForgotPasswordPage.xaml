<Page
    x:Class="AllInsurance.Desktop.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="650">
            <Border Width="460" Padding="32" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="ALL INSURANCE" Foreground="{ThemeResource BrandAccentBrush}"
                               FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="Reset your password" FontSize="30" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Enter your username and individual recovery code."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Username" />
                    <TextBox Text="{Binding Username, Mode=TwoWay}" AutomationProperties.Name="Username" />
                    <TextBlock Text="Recovery code" />
                    <PasswordBox x:Name="RecoveryCodeInput" PasswordChanged="RecoveryCodeChanged"
                                 AutomationProperties.Name="Recovery code" />
                    <TextBlock Text="New password" />
                    <PasswordBox x:Name="NewPasswordInput" PasswordChanged="NewPasswordChanged"
                                 AutomationProperties.Name="New password" />
                    <TextBlock Text="Confirm new password" />
                    <PasswordBox x:Name="ConfirmationInput" PasswordChanged="ConfirmationChanged"
                                 AutomationProperties.Name="Confirm new password" />
                    <TextBlock Text="Use a passphrase with at least 12 characters."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorTextBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                                  HorizontalAlignment="Center" />
                    <Button Content="Reset password" Command="{Binding ResetPasswordCommand}"
                            Background="{ThemeResource ButtonAccentBrush}" Foreground="White" />
                    <HyperlinkButton Content="Back to sign in" Command="{Binding BackToSignInCommand}"
                                     HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
