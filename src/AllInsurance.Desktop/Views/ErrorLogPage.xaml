<Page
    x:Class="AllInsurance.Desktop.Views.ErrorLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer SizeChanged="Scroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="1100" Margin="24" Spacing="16" HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="Ημερολόγιο σφαλμάτων" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Πρόσφατα σφάλματα της εφαρμογής. Επιλέξτε μία εγγραφή για τις τεχνικές λεπτομέρειες."
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="PathText" TextWrapping="Wrap" />
                    <TextBox x:Name="SearchInput" PlaceholderText="Αναζήτηση σφάλματος ή ενότητας..."
                             Height="42" MinHeight="42" TextChanged="Search_Changed" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <ListView x:Name="ErrorsList" Height="500" SelectionChanged="Errors_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="3" Padding="4,8">
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
