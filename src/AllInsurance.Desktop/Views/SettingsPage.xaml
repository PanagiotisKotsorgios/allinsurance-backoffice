<Page
    x:Class="AllInsurance.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer SizeChanged="Scroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="1100" Margin="24" Spacing="18" HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Ρυθμίσεις συστήματος" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Εμφάνιση και πληροφορίες της τοπικής εγκατάστασης."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="Εμφάνιση" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeChoice" Header="Θέμα εφαρμογής" MinWidth="220">
                        <ComboBoxItem Content="Σύμφωνα με τα Windows" />
                        <ComboBoxItem Content="Φωτεινό" />
                        <ComboBoxItem Content="Σκούρο" />
                    </ComboBox>
                    <Button Content="Αποθήκευση θέματος" Click="SaveTheme_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Τοπική εγκατάσταση" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DatabasePathText" TextWrapping="Wrap" />
                    <TextBlock x:Name="LockoutPolicyText" TextWrapping="Wrap" />
                    <TextBlock Text="Η γλώσσα της εφαρμογής είναι Ελληνικά." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
