<Page
    x:Class="AllInsurance.Desktop.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundBrush}" Padding="16,8">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="ms-appx:///Assets/logo-99.jpg" Width="34" Height="34"
                           AutomationProperties.Name="Λογότυπο AllInsurance Backoffice Software" />
                    <TextBlock Text="AllInsurance Backoffice Software" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <MenuBar VerticalAlignment="Center">
                        <MenuBarItem Title="Πλοήγηση">
                            <MenuFlyoutItem Text="Πελάτες" Click="Customers_Click" />
                            <MenuFlyoutItem Text="Ασφαλιστήρια" Click="Policies_Click" />
                            <MenuFlyoutItem Text="Ζημιές" Click="Claims_Click" />
                            <MenuFlyoutItem Text="Αναφορές" Click="Reports_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Εργαλεία">
                            <MenuFlyoutItem x:Name="UsersMenuItem" Text="Διαχείριση χρηστών" Click="Users_Click" />
                            <MenuFlyoutItem x:Name="AuditMenuItem" Text="Αρχείο ελέγχου" Click="Audit_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Ρυθμίσεις">
                            <MenuFlyoutItem Text="Ρυθμίσεις συστήματος" Click="Settings_Click" />
                            <MenuFlyoutItem Text="Διαχείριση συντομεύσεων" Click="Shortcuts_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Βοήθεια">
                            <MenuFlyoutItem Text="Οδηγός χρήσης" Click="Guide_Click" />
                            <MenuFlyoutItem Text="Επικοινωνία" Click="Contact_Click" />
                            <MenuFlyoutItem Text="Σχετικά" Click="About_Click" />
                        </MenuBarItem>
                        </MenuBar>
                    </ScrollViewer>
                    <Button Grid.Column="1" Content="Αποσύνδεση" Click="SignOut_Click"
                            Background="#FFC62828" Foreground="#FFFFFFFF"
                            VerticalAlignment="Center" UseSystemFocusVisuals="True"
                            AutomationProperties.Name="Αποσύνδεση">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFC62828" CornerRadius="6" Padding="16,8">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      Foreground="#FFFFFFFF"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
        <NavigationView x:Name="MainNavigation" Grid.Row="1" PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" AlwaysShowHeader="False"
                        OpenPaneLength="310" CompactPaneLength="68" SelectionChanged="Navigation_SelectionChanged">
            <ContentControl x:Name="SectionHost" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" Padding="16,8"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="DatabaseIndicator" Width="9" Height="9" Fill="#FFBF8B1B" VerticalAlignment="Center" />
                    <TextBlock x:Name="DatabaseStatusText" Text="Έλεγχος βάσης δεδομένων…"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="SessionText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </Grid>
        </Border>
    </Grid>
</Page>
