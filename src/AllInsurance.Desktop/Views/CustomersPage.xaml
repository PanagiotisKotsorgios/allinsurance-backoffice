<Page
    x:Class="AllInsurance.Desktop.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer x:Name="Scroller" SizeChanged="Scroller_SizeChanged"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="1380" Margin="24" Spacing="16"
                    HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Πελάτες" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock x:Name="TotalBadge" Text="0 εγγραφές" VerticalAlignment="Center"
                                       Foreground="{ThemeResource BrandAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectedBadge" Text="0 επιλεγμένοι" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="Καρτέλες, στοιχεία επικοινωνίας, συστάσεις και οικονομικό ιστορικό."
                                   Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:ActionButton Grid.Row="1" Kind="Add" Label="Προσθήκη πελάτη"
                                           Click="Add_Click" HorizontalAlignment="Left" />
                </Grid>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Φίλτρα" FontSize="18" FontWeight="SemiBold" />
                    <TextBox x:Name="SearchInput" Height="42" MinHeight="42"
                             PlaceholderText="Αναζήτηση: π.χ. Βιλλίου, 123456789, C-000001, 693..., email ή πόλη"
                             TextChanged="Filter_Changed" AutomationProperties.Name="Αναζήτηση πελατών" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="224" ItemHeight="50">
                        <controls:MultiSelectFilter x:Name="StatusFilter" Title="Κατάσταση" Width="210" Height="42" />
                        <controls:MultiSelectFilter x:Name="BalanceFilter" Title="Υπόλοιπο" Width="210" Height="42" />
                        <controls:MultiSelectFilter x:Name="OwnershipFilter" Title="Ιδιοκτησία" Width="210" Height="42" />
                        <controls:MultiSelectFilter x:Name="KindFilter" Title="Είδος" Width="210" Height="42" />
                        <controls:MultiSelectFilter x:Name="CityFilter" Title="Πόλη" Width="210" Height="42" />
                        <controls:MultiSelectFilter x:Name="PartnerFilter" Title="Συνεργάτης" Width="210" Height="42" />
                        <controls:ActionButton Kind="Filter" Label="Καθαρισμός φίλτρων"
                                               Width="210" Height="42" Click="ClearFilters_Click" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="224" ItemHeight="50">
                        <controls:ActionButton Kind="Edit" Label="Επεξεργασία πελάτη"
                                               Width="210" Click="Open_Click" />
                        <controls:ActionButton Kind="Delete" Label="Διαγραφή πελάτη"
                                               Width="210" Click="Delete_Click" />
                        <controls:ActionButton Kind="Statistics" Label="Στατιστικά πελατών"
                                               Width="210" Click="Statistics_Click" />
                        <controls:ActionButton Kind="Refresh" Label="Ανανέωση"
                                               Width="210" Click="Refresh_Click" />
                        <controls:ActionButton Kind="Choice" Label="Διαχείριση στηλών"
                                               Width="210" Click="Columns_Click" />
                    </VariableSizedWrapGrid>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TableStack" Width="1590">
                            <Border Background="{ThemeResource PageBackgroundBrush}" Padding="12,10"
                                    CornerRadius="8">
                                <Grid x:Name="TableHeader" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125" /><ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="155" /><ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="180" /><ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="220" /><ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Κωδικός" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Είδος" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Επώνυμο" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Όνομα" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Επωνυμία" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="ΑΦΜ" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Email" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Κινητό" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="8" Text="Πόλη" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="9" Text="Υπόλοιπο" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <ListView x:Name="CustomersList" IsItemClickEnabled="True"
                                      ItemClick="Customer_ItemClick" SelectionMode="Single"
                                      SelectionChanged="Customers_SelectionChanged"
                                      Height="460" AutomationProperties.Name="Πίνακας πελατών">

                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton Kind="Previous" Label="Προηγούμενη"
                                                   Click="Previous_Click" />
                            <controls:ActionButton Kind="Next" Label="Επόμενη"
                                                   Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
