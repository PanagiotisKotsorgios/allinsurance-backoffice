<Page
    x:Class="AllInsurance.Desktop.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid x:Name="PageContent" Margin="16,10,16,10" RowDefinitions="35,Auto,Auto,*" RowSpacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12" Height="35" VerticalAlignment="Center">
                <TextBlock Text="Πελάτες" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="TotalBadge" Text="0 εγγραφές" VerticalAlignment="Center"
                           Foreground="{ThemeResource BrandAccentBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="SelectedBadge" Text="0 επιλεγμένοι" VerticalAlignment="Center"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="14,10">
                <StackPanel Spacing="7">
                    <TextBlock Text="Φίλτρα" FontSize="18" FontWeight="SemiBold" />
                    <Border Height="46" CornerRadius="9" BorderBrush="#7C91A7"
                            BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" Height="42" MinHeight="42" CornerRadius="7"
                                 BorderThickness="0" Padding="42,7,12,7" VerticalContentAlignment="Center"
                                 PlaceholderText="Αναζήτηση: π.χ. Βιλλίου, 123456789, C-000001, 693..., email ή πόλη"
                                 TextChanged="Filter_Changed" AutomationProperties.Name="Αναζήτηση πελατών" />
                        <controls:SearchGlyph Width="24" Height="24" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                    </Grid>
                    </Border>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="224" ItemHeight="36">
                        <controls:MultiSelectFilter x:Name="BalanceFilter" Title="Υπόλοιπο" Width="210" Height="36" />
                        <controls:MultiSelectFilter x:Name="KindFilter" Title="Είδος" Width="210" Height="36" />
                        <controls:MultiSelectFilter x:Name="CityFilter" Title="Πόλη" Width="210" Height="36" />
                        <controls:MultiSelectFilter x:Name="PartnerFilter" Title="Συνεργάτης" Width="210" Height="36" />
                        <controls:ActionButton Kind="Clear" Label="Καθαρισμός φίλτρων"
                                               Width="210" Height="36" Click="ClearFilters_Click" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="8,7" MinHeight="50">
                <Grid x:Name="ActionsGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                      SizeChanged="ActionsGrid_SizeChanged">
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="210" ItemHeight="36" VerticalAlignment="Center">
                        <controls:ActionButton Kind="Add" Label="Προσθήκη πελάτη" Width="180" Height="36" Click="Add_Click" />
                        <controls:ActionButton Kind="Edit" Label="Επεξεργασία πελάτη" Width="195" Height="36" Click="Open_Click" />
                        <controls:ActionButton Kind="Columns" Label="Διαχείριση στηλών" Width="180" Height="36" Click="Columns_Click" />
                    </VariableSizedWrapGrid>
                    <controls:ActionButton Grid.Column="1" Kind="Delete" Label="Διαγραφή πελάτη"
                                           Width="175" Height="36" Click="Delete_Click"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="14,10">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ScrollViewer x:Name="TableViewport" Grid.Row="1" SizeChanged="TableViewport_SizeChanged"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TableStack" Width="1590" HorizontalAlignment="Left">
                            <Border Background="{ThemeResource TableHeaderBackgroundBrush}" Padding="0"
                                    BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1"
                                    CornerRadius="8">
                                <Grid ColumnDefinitions="40,*">
                                    <controls:VisibleSelectionCheckBox x:Name="SelectAllCustomers" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" ToolTipService.ToolTip="Επιλογή όλων των αποτελεσμάτων"
                                              Checked="SelectAllCustomers_Changed" Unchecked="SelectAllCustomers_Changed" />
                                <Grid x:Name="TableHeader" Grid.Column="1" ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125" /><ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="155" /><ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="180" /><ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Κωδικός" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Είδος" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Επώνυμο" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Όνομα" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Επωνυμία" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="ΑΦΜ" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Email" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="7" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Πόλη" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="8" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,0" Padding="10,8"><TextBlock Text="Υπόλοιπο" FontWeight="SemiBold" /></Border>
                                </Grid>
                                </Grid>
                            </Border>
                            <ListView x:Name="CustomersList" IsItemClickEnabled="True" Padding="0"
                                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1,0,1,1"
                                      SelectionMode="Single"
                                      SelectionChanged="Customers_SelectionChanged"
                                      Height="460" AutomationProperties.Name="Πίνακας πελατών">

                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton Kind="Previous" Label="Προηγούμενη"
                                                   Click="Previous_Click" />
                            <controls:ActionButton Kind="Next" Label="Επόμενη"
                                                   Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</Page>
