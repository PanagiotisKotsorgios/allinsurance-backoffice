<Page
    x:Class="AllInsurance.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid MinHeight="650">
        <Border Width="440" Padding="32" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="ALL INSURANCE" Foreground="{ThemeResource BrandAccentBrush}"
                           FontSize="13" FontWeight="Bold" />
                <TextBlock Text="Welcome back" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Sign in to All Insurance" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="15" />
                <TextBlock Text="Username" />
                <TextBox Text="{Binding Username, Mode=TwoWay}" AutomationProperties.Name="Username" />
                <TextBlock Text="Password" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged"
                             KeyDown="PasswordKeyDown" AutomationProperties.Name="Password" />
                <CheckBox Content="Show password" Checked="ShowPasswordChanged"
                          Unchecked="ShowPasswordChanged" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorTextBrush}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                              HorizontalAlignment="Center" />
                <Button Content="Sign in" Command="{Binding SignInCommand}"
                        Background="{ThemeResource ButtonAccentBrush}" Foreground="White" />
                <HyperlinkButton Content="Forgot password?" Command="{Binding OpenForgotPasswordCommand}"
                                 HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
