<Page
    x:Class="AllInsurance.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Border MaxWidth="440" Margin="12" Padding="20" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image Source="ms-appx:///Assets/logo-99.jpg" Width="44" Height="44" AutomationProperties.Name="Λογότυπο AllInsurance Backoffice Software" />
                    <TextBlock Text="AllInsurance Backoffice Software" Foreground="{ThemeResource BrandAccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Καλώς ήρθατε ξανά" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Συνδεθείτε στο AllInsurance Backoffice Software" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="15" />
                <TextBlock Text="Όνομα χρήστη" />
                <TextBox Text="{Binding Username, Mode=TwoWay}" AutomationProperties.Name="Όνομα χρήστη" />
                <TextBlock Text="Κωδικός πρόσβασης" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged"
                             KeyDown="PasswordKeyDown" AutomationProperties.Name="Κωδικός πρόσβασης" />
                <CheckBox Content="Εμφάνιση κωδικού" Checked="ShowPasswordChanged"
                          Unchecked="ShowPasswordChanged" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorTextBrush}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                              HorizontalAlignment="Center" />
                <controls:ActionButton Kind="Open" Label="Σύνδεση" Command="{Binding SignInCommand}" />
                <HyperlinkButton Content="Ξεχάσατε τον κωδικό;" Command="{Binding OpenForgotPasswordCommand}"
                                 HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
