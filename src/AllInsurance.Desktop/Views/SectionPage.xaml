<Page
    x:Class="AllInsurance.Desktop.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer x:Name="PageScroller" SizeChanged="Scroller_SizeChanged"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="1380" Margin="24" Spacing="16"
                    HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="18" RowSpacing="12">
                    <Border x:Name="IconBackground" Width="70" Height="70" CornerRadius="14">
                        <Image x:Name="SectionIcon" Width="48" Height="48" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="SectionTitle" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TotalBadge" Text="0 εγγραφές" VerticalAlignment="Center"
                                       Foreground="{ThemeResource BrandAccentBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="SectionDescription" FontSize="15" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="188" ItemHeight="50">
                            <controls:ActionButton x:Name="AddButton" Kind="Add" Label="Προσθήκη" Width="178" Click="Add_Click" />
                            <controls:ActionButton Kind="Edit" Label="Επεξεργασία" Width="178" Click="Edit_Click" />
                            <controls:ActionButton Kind="Statistics" Label="Στατιστικά" Width="178" Click="Statistics_Click" />
                        </VariableSizedWrapGrid>
                        <controls:ActionButton Grid.Column="1" Kind="Delete" Label="Διαγραφή"
                                               Click="Delete_Click" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Φίλτρα" FontSize="18" FontWeight="SemiBold" />
                    <TextBox x:Name="SearchInput" Height="42" MinHeight="42" TextChanged="Filter_Changed" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="224" ItemHeight="50">
                            <controls:MultiSelectFilter x:Name="StatusFilter" Title="Κατάσταση" Width="210" Height="42" />
                            <controls:MultiSelectFilter x:Name="CustomerFilter" Title="Πελάτης" Width="210" Height="42" />
                            <CalendarDatePicker x:Name="FromFilter" Width="210" Height="42"
                                                PlaceholderText="Από ημερομηνία" DateChanged="DateFilter_Changed" />
                            <CalendarDatePicker x:Name="UntilFilter" Width="210" Height="42"
                                                PlaceholderText="Έως ημερομηνία" DateChanged="DateFilter_Changed" />
                            <controls:ActionButton Kind="Clear" Label="Καθαρισμός φίλτρων"
                                                   Width="210" Height="42" Click="ClearFilters_Click" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Width="1212" HorizontalAlignment="Left">
                            <Border Background="{ThemeResource TableHeaderBackgroundBrush}" CornerRadius="8"
                                    BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1"
                                    Padding="0">
                                <Grid ColumnDefinitions="40,*">
                                    <controls:VisibleSelectionCheckBox x:Name="SelectAllRecords" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" ToolTipService.ToolTip="Επιλογή όλων των αποτελεσμάτων"
                                              Checked="SelectAllRecords_Changed" Unchecked="SelectAllRecords_Changed" />
                                <Grid x:Name="RecordsHeader" Grid.Column="1" ColumnDefinitions="240,140,190,130,130,240,100"
                                      ColumnSpacing="0">
                                    <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="TitleHeader" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Κωδικός" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="PartyHeader" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Κατάσταση" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Ημερομηνία" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Πελάτης" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0" Padding="10,8"><TextBlock Text="Εγγραφή" FontWeight="SemiBold" /></Border>
                                </Grid>
                                </Grid>
                            </Border>
                            <ListView x:Name="RecordsList" Height="440" Padding="0"
                                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1,0,1,1"
                                      SelectionMode="Single" SelectionChanged="Records_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="40,240,140,190,130,130,240,100" Loaded="RecordRow_Loaded"
                                              ColumnSpacing="0" Width="1210" Height="39">
                                            <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1">
                                                <controls:VisibleSelectionCheckBox Tag="{Binding Record.Id}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Checked="RecordCheck_Changed" Unchecked="RecordCheck_Changed" />
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Reference}" />
                                            </Border>
                                            <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding RelatedParty}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Status}" />
                                            </Border>
                                            <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding EventDateDisplay}" />
                                            </Border>
                                            <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="7" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                                                <TextBlock Text="{Binding CreatedDisplay}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton Kind="Previous" Label="Προηγούμενη" Click="Previous_Click" />
                            <controls:ActionButton Kind="Next" Label="Επόμενη" Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="RelatedRecordsBorder" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Σχετικά στοιχεία από καρτέλες πελατών"
                               FontSize="18" FontWeight="SemiBold" />
                    <controls:ActionButton Kind="Open" Label="Άνοιγμα πελάτη" Click="OpenRelatedCustomer_Click"
                            HorizontalAlignment="Left" />
                    <ListView x:Name="RelatedRecordsList" Height="180" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="16" Padding="4,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
