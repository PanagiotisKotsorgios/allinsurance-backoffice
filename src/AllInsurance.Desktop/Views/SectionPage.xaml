<Page
    x:Class="AllInsurance.Desktop.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid x:Name="PageContent" Margin="16,10,16,10" RowDefinitions="35,Auto,Auto,*" RowSpacing="14">
            <Grid Height="35" VerticalAlignment="Center" ColumnDefinitions="Auto,*">
                    <Border x:Name="IconBackground" Width="70" Height="70" CornerRadius="14">
                        <Image x:Name="SectionIcon" Width="48" Height="48" />
                    </Border>
                    <StackPanel x:Name="HeadingPanel" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="SectionTitle" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock x:Name="TotalBadge" Text="0 εγγραφές" VerticalAlignment="Center"
                                       Foreground="{ThemeResource BrandAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectedBadge" Text="0 επιλεγμένες" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SecondaryTextBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="SectionDescription" Visibility="Collapsed" FontSize="15" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SecondaryTextBrush}" />
                    </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="14,10">
                <StackPanel Spacing="7">
                    <TextBlock Text="Φίλτρα" FontSize="18" FontWeight="SemiBold" />
                    <Border Height="46" CornerRadius="9" BorderBrush="#7C91A7"
                            BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" Height="42" MinHeight="42" CornerRadius="7"
                                 BorderThickness="0" Padding="42,0,12,0" VerticalContentAlignment="Center"
                                 TextChanged="Filter_Changed" />
                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                  Width="24" Height="24" Margin="12,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  IsHitTestVisible="False" />
                    </Grid>
                    </Border>
                    <VariableSizedWrapGrid x:Name="FilterBar" Orientation="Horizontal"
                                           ItemWidth="190" ItemHeight="36" HorizontalAlignment="Stretch"
                                           SizeChanged="FilterBar_SizeChanged">
                        <controls:MultiSelectFilter x:Name="StatusFilter" Title="Κατάσταση" Height="36" />
                        <controls:MultiSelectFilter x:Name="CustomerFilter" Title="Πελάτης" Height="36" />
                        <controls:MultiSelectFilter x:Name="CityFilter" Title="Πόλη / περιοχή" Height="36" />
                        <controls:MultiSelectFilter x:Name="PersonTypeFilter" Title="Τύπος προσώπου" Height="36" />
                        <controls:ActionButton x:Name="DateRangeFilter" Kind="Choice" Label="Ημερομηνία" Height="36">
                            <controls:ActionButton.Flyout>
                                <Flyout>
                                    <StackPanel Width="260" Spacing="10" Padding="8">
                                        <TextBlock Text="Εύρος ημερομηνιών" FontWeight="SemiBold" />
                                        <ComboBox x:Name="DateBasisFilter" Height="38" HorizontalAlignment="Stretch"
                                                  SelectionChanged="DateBasis_Changed" />
                                        <CalendarDatePicker x:Name="FromFilter" Height="42" HorizontalAlignment="Stretch"
                                                            PlaceholderText="Από" DateChanged="DateFilter_Changed" />
                                        <CalendarDatePicker x:Name="UntilFilter" Height="42" HorizontalAlignment="Stretch"
                                                            PlaceholderText="Έως" DateChanged="DateFilter_Changed" />
                                    </StackPanel>
                                </Flyout>
                            </controls:ActionButton.Flyout>
                        </controls:ActionButton>
                        <controls:ActionButton x:Name="ClearFiltersButton" Kind="Clear" Label="Καθαρισμός φίλτρων"
                                               Height="36" Click="ClearFilters_Click" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="8,7" MinHeight="50">
                <Grid x:Name="ActionsGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                      SizeChanged="ActionsGrid_SizeChanged">
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="245" ItemHeight="36" VerticalAlignment="Center">
                        <controls:ActionButton x:Name="AddButton" Kind="Add" Label="Προσθήκη" Width="230" Height="36" Click="Add_Click" />
                        <controls:ActionButton Kind="Edit" Label="Επεξεργασία" Width="195" Height="36" Click="Edit_Click" />
                        <controls:ActionButton Kind="Columns" Label="Διαχείριση στηλών" Width="180" Height="36" Click="Columns_Click" />
                    </VariableSizedWrapGrid>
                    <controls:ActionButton x:Name="DeleteButton" Grid.Column="1" Kind="Delete" Label="Διαγραφή"
                                           Width="175" Height="36" Click="Delete_Click"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid Grid.Row="3" RowDefinitions="*,Auto" RowSpacing="10">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="14,10">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ScrollViewer x:Name="TableViewport" Grid.Row="1" SizeChanged="TableViewport_SizeChanged"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RecordsTableStack" Width="1212" HorizontalAlignment="Left">
                            <Border Background="{ThemeResource TableHeaderBackgroundBrush}" CornerRadius="8"
                                    BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1"
                                    Padding="0">
                                <Grid ColumnDefinitions="40,*">
                                    <controls:VisibleSelectionCheckBox x:Name="SelectAllRecords" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" ToolTipService.ToolTip="Επιλογή όλων των αποτελεσμάτων"
                                              Checked="SelectAllRecords_Changed" Unchecked="SelectAllRecords_Changed" />
                                <Grid x:Name="RecordsHeader" Grid.Column="1" ColumnDefinitions="240,140,190,130,130,240,100"
                                      ColumnSpacing="0">
                                    <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="TitleHeader" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Κωδικός" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="PartyHeader" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Κατάσταση" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Ημερομηνία" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock Text="Πελάτης" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0" Padding="10,8"><TextBlock Text="Εγγραφή" FontWeight="SemiBold" /></Border>
                                </Grid>
                                </Grid>
                            </Border>
                            <ListView x:Name="RecordsList" Height="440" Padding="0"
                                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1,0,1,1"
                                      SelectionMode="Single" SelectionChanged="Records_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="40,240,140,190,130,130,240,100" Loaded="RecordRow_Loaded" Unloaded="RecordRow_Unloaded"
                                              ColumnSpacing="0" Width="1210" Height="39">
                                            <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1">
                                                <controls:VisibleSelectionCheckBox Tag="{Binding Record.Id}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Checked="RecordCheck_Changed" Unchecked="RecordCheck_Changed" />
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Reference}" />
                                            </Border>
                                            <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding RelatedParty}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Status}" />
                                            </Border>
                                            <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding EventDateDisplay}" />
                                            </Border>
                                            <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="7" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                                                <TextBlock Text="{Binding CreatedDisplay}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton Kind="Previous" Label="Προηγούμενη" Click="Previous_Click" />
                            <controls:ActionButton Kind="Next" Label="Επόμενη" Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="RelatedRecordsBorder" Grid.Row="1" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Σχετικά στοιχεία από καρτέλες πελατών"
                               FontSize="18" FontWeight="SemiBold" />
                    <controls:ActionButton Kind="Open" Label="Άνοιγμα πελάτη" Click="OpenRelatedCustomer_Click"
                            HorizontalAlignment="Left" />
                    <ListView x:Name="RelatedRecordsList" Height="180" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="16" Padding="4,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            </Grid>
    </Grid>
</Page>
